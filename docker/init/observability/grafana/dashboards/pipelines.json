{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "__requires": [],
  "uid": "matelot-pipelines",
  "title": "Matelot \u00b7 Pipelines",
  "description": "Pipeline jobs by kind: durations, failures, queue wait, runner utilisation; the traces are one click away through exemplars.",
  "tags": [
    "matelot",
    "pipelines"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "cell",
        "label": "Cell",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(matelot_build_info, cell)",
          "refId": "cell"
        },
        "definition": "label_values(matelot_build_info, cell)",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "kind",
        "label": "Job kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "query_result(sum by (kind) (matelot_pipeline_jobs_total{cell=\"$cell\"}) > 0)",
          "refId": "kind"
        },
        "definition": "query_result(sum by (kind) (matelot_pipeline_jobs_total{cell=\"$cell\"}) > 0)",
        "regex": "/kind=\"([^\"]+)\"/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Matelot dashboards",
      "type": "dashboards",
      "tags": [
        "matelot"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Observability guide",
      "type": "link",
      "url": "https://matelot.cloud/docs/latest/observability.html",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Traces",
      "gridPos": {
        "w": 24,
        "h": 3,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Every pipeline is **one trace** under service `matelot-pipeline` (api, runner and worker spans together). From here: the exemplars on the duration panels (the dots) open the trace of that very job in Tempo; Explore \u2192 Tempo \u2192 search service `matelot-pipeline`, or TraceQL `{ resource.service.name = \"matelot-pipeline\" && span.matelot.pipeline.status = \"failed\" }` for the failed ones. [How the trace is built](https://matelot.cloud/docs/latest/observability.html#traces)."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Jobs",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Job duration p95 by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(matelot_pipeline_job_duration_seconds_bucket{kind=~\"$kind\", cell=\"$cell\"}[$__rate_interval]))) >= 0",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "started \u2192 finished, from the cell's view; exemplars link to the trace"
    },
