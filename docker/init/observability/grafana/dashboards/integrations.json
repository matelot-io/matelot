      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (queue, result) (increase(matelot_queue_jobs_processed_total{cell=\"$cell\"}[1h]))",
          "legendFormat": "{{queue}} \u00b7 {{result}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 1
