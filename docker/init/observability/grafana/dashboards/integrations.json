        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Webhook lag p95 by provider",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(matelot_webhook_lag_seconds_bucket{cell=\"$cell\"}[$__rate_interval]))) >= 0",
          "legendFormat": "{{provider}}",
          "refId": "A",
          "range": true,
          "instant": false
