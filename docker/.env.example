# Matelot Docker Compose — copy to .env and edit. Everything not listed here is generated on first start.
# Release to run (images ghcr.io/matelot-cloud/{api,web,worker,runner}:<version>). Upgrade = change + `docker compose pull && docker compose up -d`.
MATELOT_VERSION=0.1.0

# Hostname users open. `localhost` (or an IP) = plain HTTP on port 80 and the registry on localhost:5000.
# A real DNS name = automatic HTTPS (Let's Encrypt) on 443 for <domain> and registry.<domain>; both names must point at this host.
MATELOT_DOMAIN=localhost
# E-mail for Let's Encrypt expiry notices (recommended with a real domain).
MATELOT_ACME_EMAIL=

# First administrator: this e-mail becomes administrator of the root organization on its first login.
# The password is generated on first start (`docker compose logs welcome`), or set it here before the first start.
MATELOT_ADMIN_EMAIL=admin@localhost
MATELOT_ADMIN_PASSWORD=

# Root organization (slug is permanent).
MATELOT_ORG_SLUG=main
MATELOT_ORG_NAME=My organization
# Sign-in page branding (optional): a logo URL or data: URI shown above the form, and the button / link colour
#MATELOT_THEME_LOGO=https://example.com/logo.png
#MATELOT_THEME_PRIMARY_COLOR=#0f766e

# Published ports (change only if 80/443 are taken on this host).
MATELOT_HTTP_PORT=80
MATELOT_HTTPS_PORT=443
MATELOT_REGISTRY_PORT=5000

# Licence key (M13): empty = Free tier. Can also be entered later in Settings → License.
MATELOT_LICENSE=

# Backups kept on the backups volume (days).
MATELOT_BACKUP_RETENTION_DAYS=14

# Observability (docs/observability.md). Metrics are always served on :9464 of the api, worker and runner containers
# (compose network only; a Prometheus on the same host joins the network to scrape them). Traces leave the cell over
# OTLP once an endpoint is set: Jaeger, Tempo, an OTel Collector, Grafana Cloud (headers carry its token).
#MATELOT_OTLP_ENDPOINT=http://jaeger:4318
#MATELOT_OTLP_PROTOCOL=http/protobuf
#MATELOT_OTLP_HEADERS=Authorization=Basic%20…
#MATELOT_OTLP_METRICS=1
# The bundled stack instead (Prometheus, Tempo, Loki, Grafana at <domain>/grafana/, Alloy for container logs, the
# Postgres/Redis exporters): uncomment, then `docker compose up -d`. Sets the OTLP endpoint above to its collector when
# that is empty. Grafana: sign in with Keycloak (Viewer); local admin password: `docker compose run --rm init show`.
#COMPOSE_PROFILES=observability
#MATELOT_TRACES_SAMPLER=parentbased_always_on
#MATELOT_TRACES_GET_RATIO=0.1   # share of GET requests that start a trace (background polls never, writes always)
#MATELOT_ENVIRONMENT=production
#MATELOT_LOG_LEVEL=info,jobs=debug
